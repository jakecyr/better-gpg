			<key>NSMenuItem</key>
			<dict>
				<key>default</key>
				<string>Decrypt with GPGeze…</string>
			</dict>
			<key>NSMessage</key>
			<string>decryptFiles</string>
			<key>NSSendTypes</key>
			<array>
				<string>NSFilenamesPboardType</string>
			</array>
			<key>NSPortName</key>
			<string>GPGeze</string>
		</dict>
	</array>
