<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Extensions must be sandboxed. The extension only reads file paths from
	     FIFinderSyncController and passes them to the main app via URL scheme —
	     it never directly accesses files itself. -->
	<key>com.apple.security.app-sandbox</key>
	<true/>
</dict>
</plist>
